{{- define "tags" -}}
{{- $tags := "" -}}
{{- $tagName := .Key -}}
{{ if ne .Value.OverrideJsonTag "" }}
    {{- $tagName = .Value.OverrideJsonTag -}}
{{- end -}}
{{ if .Value.Required }}
	{{- $tags = printf "`json:\"%s,required\"" (ToSnakeCase $tagName) -}}
{{- else -}}
    {{- $tags = printf "`json:\"%s\"" (ToSnakeCase $tagName) -}}
{{ end -}}
{{- range $custom_tag := .Value.Tags }}
    {{- $tags = printf "%s %s" $tags $custom_tag -}}
{{- end }}
{{- $tags = printf "%s`" $tags }}
{{- print $tags -}}
{{- end -}}
type {{ .StructName }} struct {
{{- range $key, $value := .Fields }}
	{{ $key }} {{ $value.Type }} {{ if $.JsonTags }}{{ template "tags" Dict "Key" $key "Value" $value }}{{ end -}}
{{ end }}
}
